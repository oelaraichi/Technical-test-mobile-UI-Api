{
  "name": "mobile-automation-lydia",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wdio": "wdio run ./wdio.conf.ts",
    "test:ui": "npm run wdio",
    "test:api": "mocha --require ts-node/register/transpile-only --reporter mochawesome --reporter-options reportDir=api-report,reportFilename=api-report,quiet=true,html=true,json=true \"api-tests/**/*.spec.ts\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "reports:generate": "npm run test:ui && npm run allure:generate && npm run test:api"
  },
  "keywords": [],
  "author": "",
