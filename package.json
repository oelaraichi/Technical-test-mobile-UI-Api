  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/chai": "^5.2.1",
    "@types/mocha": "^10.0.10",
    "@wdio/allure-reporter": "^9.24.0",
    "@wdio/appium-service": "^9.24.0",
    "@wdio/cli": "^9.24.0",
    "@wdio/cucumber-framework": "^9.24.0",
    "@wdio/globals": "^9.23.0",
    "@wdio/local-runner": "^9.24.0",
    "@wdio/spec-reporter": "^9.24.0",
    "@wdio/visual-service": "^9.1.4",
    "allure-commandline": "^2.36.0",
    "axios": "^1.13.2",
    "appium-uiautomator2-driver": "^6.8.2",
    "chai": "^6.2.1",
    "expect-webdriverio": "^5.6.4",
    "mocha": "^11.7.4",
    "mochawesome": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
